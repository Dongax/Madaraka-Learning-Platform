# Copy this file to .env and edit the values before running in production.

# Port the Express server listens on
PORT=3000

# Secret used to sign session (JWT) cookies — set this to a long random string
JWT_SECRET=change-this-to-a-long-random-string

# Credentials for the first admin account, created automatically the first
# time the server starts if no admin account exists yet (or via `npm run seed`).
ADMIN_ID=admin
ADMIN_NAME=School Administrator
ADMIN_PASSWORD=change-me-now

# Optional: where the SQLite database file is stored.
# Default: ./data/school.db
# DB_PATH=./data/school.db

# ─── FREE HOSTED DATABASE (optional) ───
# Leave these two blank for local use (data goes in ./data/school.db).
# On a host with no persistent disk (e.g. Render's FREE web service), create a
# free Turso database and set BOTH, so data survives restarts and redeploys:
#   TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   TURSO_AUTH_TOKEN=your-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
