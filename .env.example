# Copy this file to .env and edit the values before running in production.

# Port the Express server listens on
PORT=3000

# Secret used to sign session (JWT) cookies — set this to a long random string
JWT_SECRET=change-this-to-a-long-random-string

# Credentials for the first admin account, created automatically the first
# time the server starts if no admin account exists yet (or via `npm run seed`).
ADMIN_ID=admin
ADMIN_NAME=School Administrator
ADMIN_PASSWORD=change-me-now
